# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Committed on purpose: production build inputs for the extension are all
# public values (publishable key, site URL, the ID-pinning PUBLIC key).
!extension/.env.production

# local PGlite database
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Subagent-driven-development scratch workspace (ledger, briefs, review packages)
.superpowers/

# browser extension (separate project — own lockfile, not deployed)
extension/node_modules/
extension/dist/
extension/release/
extension/*.zip
# Intermediate build output: the injected IIFE is emitted into public/ so the
# main build copies it into dist as a static asset.
extension/public/inject/
