{
  "name": "orbit-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Orbit browser extension \u2014 see who you already know on the pages you're reading.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:tokens && npm run build:inject && vite build",
    "build:inject": "vite build --config vite.inject.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:tokens": "node scripts/tokens.mjs check",
    "zip": "npm run build && node scripts/zip.mjs",
    "tokens:sync": "node scripts/tokens.mjs sync",
    "preview:design": "vite --config vite.preview.config.ts"
  },
  "dependencies": {
    "@clerk/chrome-extension": "^3.1.71",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^0.563.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.1",
    "@types/chrome": "^0.1.28",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "typescript": "^5",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.1.14"
  }
}
