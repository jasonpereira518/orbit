# Production build inputs — committed on purpose: nothing here is secret.
# The publishable key ships in the web app's public bundle, the app URL is the
# public site, and VITE_EXTENSION_KEY is the *public* half of the ID-pinning
# keypair (the private key.pem stays out of git). manifest.config.ts refuses a
# production build if any of these is missing or still pointing at localhost.
VITE_ORBIT_APP_URL=https://orbit.jasonpereira.live
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsub3JiaXQuamFzb25wZXJlaXJhLmxpdmUk
VITE_CLERK_FRONTEND_API=https://clerk.orbit.jasonpereira.live
VITE_EXTENSION_
