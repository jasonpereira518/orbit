# The Orbit deployment the extension talks to.
VITE_ORBIT_APP_URL=http://localhost:3000

# Clerk publishable key for that same deployment. The extension shares the web
# app's session via syncHost, so this must be the matching instance.
VITE_CLERK_PUBLISHABLE_KEY=

# Local development only: sent as x-orbit-dev-secret so the extension can call a
# dev server that has no Clerk session. Must match EXTENSION_DEV_SECRET in the
# Next app. Stripped from any non-dev bundle (src/lib/env.ts), and the server
# ignores it outside NODE_ENV=development.
VITE_ORBIT_DEV_SECRET=

# Clerk's frontend API origin for that deployment. Required for production
# builds: it becomes a host permission, and without it the panel cannot reach
# the production Clerk instance (clerk.<your-domain>), so sign-in silently
# never completes. Derivable by base64-decoding the pk_live_ key's suffix.
# Dev instances (*.clerk.accounts.dev) are covered by a wildcard already.
# VITE_CLERK_FRONTEND_API=https://clerk.your-domain.com

# Base64 public key that pins the extension ID (manifest `key` field), so an
# unpacked dev load and the published build share one ID — EXTENSION_ORIGIN in
# the Next app is an exact-match allowlist. Generate once; keep key.pem out of
# git. See README for the openssl commands.
# VITE_EXTENSION_KEY=
