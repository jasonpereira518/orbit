# The Orbit deployment the extension talks to.
VITE_ORBIT_APP_URL=http://localhost:3000

# Clerk publishable key for that same deployment. The extension shares the web
# app's session via syncHost, so this must be the matching instance.
VITE_CLERK_PUBLISHABLE_KEY=

# Local development only: sent as x-orbit-dev-secret so the extension can call a
# dev server that has no Clerk session. Must match EXTENSION_DEV_SECRET in the
# Next app. Leave blank for any real build.
VITE_ORBIT_DEV_SECRET=
