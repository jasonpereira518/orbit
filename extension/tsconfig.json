{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["chrome", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      // Type-only import of the app's wire contract. Erases at build, so the
      // extension bundle never pulls in anything from the Next app.
      "@contract": ["../src/lib/extension/contract.ts"]
    }
  },
  "include": ["src", "*.config.ts", "scripts"]
}
