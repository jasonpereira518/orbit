{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "extension-panel-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "extension",
        "run",
        "preview:design"
      ],
      "port": 5174
    },
    {
      "name": "orbit-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3001,
      "autoPort": true
    },
    {
      "name": "orbit-bench-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/bench/serve-static-bench.mjs", "3417"],
      "port": 3417
    },
    {
      "name": "orbit-demo",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        ".claude/preview-demo.sh"
      ],
      "port": 3001,
      "autoPort": true
    }
  ]
}
