    {
      "name": "request_send",
      "title": "Write an email for the user to send",
      "scope": "write",
      "surfaces": [
        "mcp"
      ],
      "resultLabel": null,
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false
